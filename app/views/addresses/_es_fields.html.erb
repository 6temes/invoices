<%# locals: (address:, object_name:, address_id: nil) -%>
<turbo-frame id="address-country-fields" data-country-selector-target="frame">
  <%= fields_for object_name, address do |f| %>
    <%= hidden_field_tag "#{object_name}[id]", address_id if address_id.present? %>
    <div class="form-group">
      <%= f.label :street, "Dirección" %>
      <%= f.text_field :street, placeholder: "Calle Example 1, 2ºA" %>
    </div>
    <div class="form-group">
      <%= f.label :extended, "Dirección (línea 2)" %>
      <%= f.text_field :extended %>
    </div>
    <div class="form-row">
      <div class="form-group">
        <%= f.label :postal_code, "Código postal" %>
        <%= f.text_field :postal_code, placeholder: "08001" %>
      </div>
      <div class="form-group">
        <%= f.label :locality, "Localidad" %>
        <%= f.text_field :locality %>
      </div>
    </div>
    <div class="form-group">
      <%= f.label :administrative_area, "Provincia" %>
      <%= f.text_field :administrative_area %>
    </div>
  <% end %>
</turbo-frame>
