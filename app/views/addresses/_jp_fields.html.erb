<%# locals: (address:, object_name:, address_id: nil) -%>
<turbo-frame id="address-country-fields" data-country-selector-target="frame">
  <%= fields_for object_name, address do |f| %>
    <%= hidden_field_tag "#{object_name}[id]", address_id if address_id.present? %>
    <div data-controller="postal-code-lookup"
         data-postal-code-lookup-url-value="<%= postal_code_lookup_path %>">
      <div class="form-row">
        <div class="form-group">
          <%= f.label :postal_code, "Postal code" %>
          <%= f.text_field :postal_code, placeholder: "164-0003",
                data: { postal_code_lookup_target: "input",
                        action: "input->postal-code-lookup#lookup" } %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :administrative_area, "Prefecture" %>
          <%= f.text_field :administrative_area,
                data: { postal_code_lookup_target: "administrativeArea" } %>
        </div>
        <div class="form-group">
          <%= f.label :locality, "City" %>
          <%= f.text_field :locality,
                data: { postal_code_lookup_target: "locality" } %>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <%= f.label :sublocality, "Neighborhood" %>
          <%= f.text_field :sublocality,
                data: { postal_code_lookup_target: "sublocality" } %>
        </div>
        <div class="form-group">
          <%= f.label :street, "Street" %>
          <%= f.text_field :street %>
        </div>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :extended, "Unit / Room" %>
      <%= f.text_field :extended %>
    </div>
  <% end %>
</turbo-frame>
