<%
  font = "-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif"
  greeting_style = "margin:0 0 16px 0; font-family:#{font}; font-size:16px; line-height:1.6; font-weight:600; color:#111827;"
  p_style = "margin:0 0 16px 0; font-family:#{font}; font-size:16px; line-height:1.7; color:#1f2933;"
  opening = t(".opening", default: "")
  signature = t(".signature", default: "")
  bank = @pending_payment.bank_details
-%>
<p class="t-strong" style="<%= greeting_style %>"><%= t(".greeting", client_name: @client.name) %></p>
<% if opening.present? %><p class="t-body" style="<%= p_style %>"><%= opening %></p><% end %>
<p class="t-body" style="<%= p_style %>"><%= t(".intro", number: @invoice.invoice_number,
      amount_received: yen(@pending_payment.amount_received), amount_remaining: yen(@pending_payment.amount_remaining)) %></p>

<%= render "amount_summary",
      number: @invoice.invoice_number,
      amount: @pending_payment.amount_remaining,
      amount_label: t("invoice.still_due"),
      date_label: t("invoice.due_date"),
      date: @invoice.due_date,
      amount_due: @invoice.amount_due,
      received: @pending_payment.amount_received %>

<%= render "bank_account", heading: t(".transfer_rest"), rows: {
      "invoice.bank_name" => bank[:bank_name],
      "invoice.bank_branch" => bank[:branch_name],
      "invoice.bank_account_type" => t("invoice.bank_account_types.#{bank[:account_type]}", default: bank[:account_type]),
      "invoice.bank_account_number" => bank[:account_number],
      "invoice.bank_account_holder" => bank[:account_holder_name]
    } %>

<p class="t-body" style="<%= p_style %>"><a href="<%= @pending_payment.instructions_url %>" target="_blank" rel="noopener" style="color:#2563eb;"><%= t("invoice.transfer_instructions") %></a></p>

<p class="t-body" style="<%= p_style %>"><%= t(".closing") %></p>
<p class="t-body" style="margin:24px 0 0 0; font-family:<%= font %>; font-size:16px; line-height:1.6; color:#1f2933;"><% if signature.present? %><%= signature %><br><% end %><strong class="t-strong" style="color:#111827;"><%= @business.name %></strong></p>
