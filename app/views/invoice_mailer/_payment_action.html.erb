<%# locals: (client:, business:, payment_url:) -%>
<% if client.stripe? && payment_url.present? %>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
    <tr>
      <td align="center">
        <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:0 auto;">
          <tr>
            <%# Padding lives on the <td> (Outlook's Word engine honours cell padding but
                drops padding on an inline <a>). Content-sized rather than a fixed-width VML
                roundrect, so the EN and JA labels both fit without clipping. -%>
            <td align="center" bgcolor="#2563eb" style="border-radius:6px; padding:14px 32px; mso-padding-alt:14px 32px;">
              <a href="<%= payment_url %>" target="_blank" rel="noopener" style="display:inline-block; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:16px; font-weight:700; line-height:1; color:#ffffff; text-decoration:none;">
                <%= t("invoice.pay") %>
              </a>
            </td>
          </tr>
        </table>
        <p class="t-muted" style="margin:12px 0 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:13px; line-height:1.5; color:#6b7280;">
          <%= t("invoice_mailer.shared.pay_note") %>
        </p>
      </td>
    </tr>
  </table>
<% else %>
  <%= render "bank_account", heading: t("invoice.bank_transfer_instructions"), rows: {
        "invoice.bank_name" => business.bank_name,
        "invoice.bank_branch" => business.bank_branch,
        "invoice.bank_account_type" => business.bank_account_type,
        "invoice.bank_account_number" => business.bank_account_number,
        "invoice.bank_account_holder" => business.bank_account_holder
      } %>
<% end %>
