<%= t(".greeting", client_name: @client.name) %>
<% opening = t(".opening", default: "") -%>
<% if opening.present? -%>
<%= opening %>
<% end -%>
<%= t(".intro", invoice_subject: @invoice.subject, period: @period) %>
<% if @credit.positive? -%>
<%= @invoice.amount_due.zero? ? t(".credit_paid", credit: yen(@credit)) : t(".credit_applied", credit: yen(@credit), amount_due: yen(@invoice.amount_due)) %>
<% end -%>

<%= render "amount_summary",
      number: @invoice.invoice_number,
      amount: @invoice.amount_due,
      amount_label: t("invoice.amount_due"),
      date_label: t("invoice.due_date"),
      date: (@invoice.due_date if @invoice.amount_due.positive?),
      total: @invoice.total,
      credit: @credit -%>
<% if @invoice.amount_due.positive? -%>

<%= render "payment_action", client: @client, business: @business, payment_url: @payment_url -%>
<% end -%>

<%= t(".attachment_note") %>

<%= t(".closing") %>
<% signature = t(".signature", default: "") -%>
<% if signature.present? -%>
<%= signature %>
<% end -%>
<%= @business.name %>
