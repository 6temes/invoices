<%# locals: (heading:, rows:) -%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="border:1px solid #e5e7eb; border-radius:8px; padding:20px 24px;" class="email-card email-rule">
      <p class="t-strong" style="margin:0 0 12px 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:15px; font-weight:700; color:#111827;">
        <%= heading %>
      </p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <% rows.each do |label_key, value| %>
          <tr>
            <td class="t-muted" style="padding:3px 12px 3px 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:14px; line-height:1.6; color:#6b7280; white-space:nowrap;">
              <%= t(label_key) %>
            </td>
            <td class="t-body" style="padding:3px 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:14px; line-height:1.6; font-weight:600; color:#1f2933;">
              <%= value %>
            </td>
          </tr>
        <% end %>
      </table>
    </td>
  </tr>
</table>
