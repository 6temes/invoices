<%# locals: (number:, amount:, amount_label:, date_label:, date:) -%>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:0 0 24px 0;">
  <tr>
    <td style="background-color:#f9fafb; border:1px solid #eef0f2; border-radius:8px; padding:24px;" class="email-card">
      <p class="t-muted" style="margin:0 0 6px 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:12px; font-weight:600; letter-spacing:0.6px; text-transform:uppercase; color:#6b7280;">
        <%= amount_label %>
      </p>
      <p class="amount-hero t-strong" style="margin:0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:40px; line-height:1.15; font-weight:700; color:#111827; white-space:nowrap;">
        <%= yen(amount) %>
      </p>

      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="margin:18px 0 0 0; border-top:1px solid #e5e7eb;" class="email-rule">
        <tr>
          <td class="t-muted" style="padding:12px 0 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:14px; line-height:1.5; color:#6b7280;">
            <%= t("invoice.id") %>
          </td>
          <td align="right" class="t-body" style="padding:12px 0 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:14px; line-height:1.5; font-weight:600; color:#1f2933; white-space:nowrap;">
            #<%= number %>
          </td>
        </tr>
        <tr>
          <td class="t-muted" style="padding:6px 0 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:14px; line-height:1.5; color:#6b7280;">
            <%= date_label %>
          </td>
          <td align="right" class="t-body" style="padding:6px 0 0 0; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue','Hiragino Sans','Yu Gothic',Meiryo,Arial,sans-serif; font-size:14px; line-height:1.5; font-weight:600; color:#1f2933; white-space:nowrap;">
            <%= date %>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
