<%# locals: (client:, business:, payment_url:) -%>
<% if client.stripe? && payment_url.present? -%>
<%= t("invoice.pay") %>: <%= payment_url %>
<%= t("invoice_mailer.shared.pay_note") %>
<% else -%>
<%= render "bank_account", heading: t("invoice.bank_transfer_instructions"), rows: business_bank_rows(business) -%>
<% end -%>
