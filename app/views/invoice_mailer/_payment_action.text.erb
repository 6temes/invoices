<%# locals: (client:, business:, payment_url:) -%>
<% if client.credit_card? && payment_url.present? -%>
<%= t("invoice.pay_with_credit_card") %>: <%= payment_url %>
<%= t("invoice_mailer.shared.pay_note") %>
<% else -%>
<%= t("invoice.bank_transfer_instructions") %>
<%= t("invoice.bank_name") %>: <%= business.bank_name %>
<%= t("invoice.bank_branch") %>: <%= business.bank_branch %>
<%= t("invoice.bank_account_type") %>: <%= business.bank_account_type %>
<%= t("invoice.bank_account_number") %>: <%= business.bank_account_number %>
<%= t("invoice.bank_account_holder") %>: <%= business.bank_account_holder %>
<% end -%>
