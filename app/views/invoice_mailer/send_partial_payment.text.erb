<%= t(".greeting", client_name: @client.name) %>
<% opening = t(".opening", default: "") -%>
<% if opening.present? -%>
<%= opening %>
<% end -%>
<%= @intro %>

<%= render "amount_summary",
      number: @invoice.invoice_number,
      amount: @pending_payment.amount_remaining,
      amount_label: t("invoice.still_due"),
      date_label: t("invoice.due_date"),
      date: @invoice.due_date,
      amount_due: @pending_payment.amount_received + @pending_payment.amount_remaining,
      received: @pending_payment.amount_received,
      received_label: @received_label -%>

<% if @pending_payment.bank_details -%>
<%= render "bank_account", heading: t(".transfer_rest"), rows: transfer_bank_rows(@pending_payment.bank_details) -%>

<%= t("invoice.transfer_instructions") %>: <%= @pending_payment.instructions_url %>
<% end -%>
<%= t(".payment_page") %>
<%= @payment_url %>

<%= t(".closing") %>
<% signature = t(".signature", default: "") -%>
<% if signature.present? -%>
<%= signature %>
<% end -%>
<%= @business.name %>
