<% bank = @pending_payment.bank_details -%>
<%= t(".greeting", client_name: @client.name) %>
<% opening = t(".opening", default: "") -%>
<% if opening.present? -%>
<%= opening %>
<% end -%>
<%= t(".intro", number: @invoice.invoice_number,
      amount_received: yen(@pending_payment.amount_received), amount_remaining: yen(@pending_payment.amount_remaining)) %>

<%= render "amount_summary",
      number: @invoice.invoice_number,
      amount: @pending_payment.amount_remaining,
      amount_label: t("invoice.still_due"),
      date_label: t("invoice.due_date"),
      date: @invoice.due_date,
      amount_due: @invoice.amount_due,
      received: @pending_payment.amount_received -%>

<%= render "bank_account", heading: t(".transfer_rest"), rows: {
      "invoice.bank_name" => bank[:bank_name],
      "invoice.bank_branch" => bank[:branch_name],
      "invoice.bank_account_type" => t("invoice.bank_account_types.#{bank[:account_type]}", default: bank[:account_type]),
      "invoice.bank_account_number" => bank[:account_number],
      "invoice.bank_account_holder" => bank[:account_holder_name]
    } -%>

<%= t("invoice.transfer_instructions") %>: <%= @pending_payment.instructions_url %>

<%= t(".closing") %>
<% signature = t(".signature", default: "") -%>
<% if signature.present? -%>
<%= signature %>
<% end -%>
<%= @business.name %>
