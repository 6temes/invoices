<% I18n.with_locale(@invoice.locale) do %>
  <div class="card payment-card">
    <h1 class="text-success">
      <%= t("invoice.thank_you_title") %>
    </h1>

    <p class="mt-2">
      <%= t("invoice.thank_you_body", number: @invoice.invoice_number) %>
    </p>

    <div class="summary-card payment-amount">
      <div class="summary-card-label"><%= t("invoice.paid_stamp") %></div>
      <div class="summary-card-value text-success">¥<%= number_with_delimiter @invoice.paid_amount %></div>
    </div>
  </div>
<% end %>
