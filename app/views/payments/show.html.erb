<% I18n.with_locale(@invoice.locale) do %>
  <div class="card payment-card">
    <h1><%= t("invoice.document_title") %> #<%= @invoice.invoice_number %></h1>
    <p class="text-muted"><%= @invoice.client.name %></p>

    <% if @pending_payment&.bank_transfer? %>
      <div class="summary-card payment-amount">
        <div class="summary-card-label"><%= t("invoice.still_due") %></div>
        <div class="summary-card-value">¥<%= number_with_delimiter @pending_payment.amount_remaining %></div>
      </div>

      <dl class="pending-figures">
        <dt><%= t("invoice.amount_due") %></dt>
        <dd>¥<%= number_with_delimiter @invoice.amount_due %></dd>

        <dt><%= t("invoice.amount_received") %></dt>
        <dd>¥<%= number_with_delimiter @pending_payment.amount_received %></dd>
      </dl>
    <% else %>
      <div class="summary-card payment-amount">
        <div class="summary-card-label"><%= t("invoice.amount_due") %></div>
        <div class="summary-card-value">¥<%= number_with_delimiter @invoice.amount_due %></div>
      </div>
    <% end %>

    <div class="detail-section">
      <div class="detail-label"><%= t("invoice.subject_label") %></div>
      <div class="detail-value"><%= @invoice.subject %></div>
    </div>

    <div class="detail-section mt-1">
      <div class="detail-label"><%= t("invoice.due_date") %></div>
      <div class="detail-value"><%= @invoice.due_date %></div>
    </div>

    <% if @pending_payment&.bank_transfer? %>
      <% notice = @pending_payment.amount_received.positive? ? "invoice.payment_partially_received" : "invoice.payment_pending" %>
      <p class="payment-pending mt-3"><%= t(notice) %></p>
      <p class="mt-1"><%= link_to t("invoice.transfer_instructions"), @pending_payment.instructions_url, target: "_blank", rel: "noopener" %></p>
    <% elsif @pending_payment %>
      <p class="payment-pending mt-3"><%= t("invoice.payment_pending") %></p>
    <% elsif @invoice.sent? && @invoice.client.stripe? %>
      <div class="mt-3">
        <%= form_with url: public_payment_create_path(params[:token]), method: :post do %>
          <%= submit_tag t("invoice.pay"), class: "btn btn-accent btn-lg" %>
        <% end %>
      </div>
    <% elsif @invoice.sent? %>
      <div class="bank-transfer">
        <p class="bank-transfer-intro"><%= t("invoice.bank_transfer_instructions") %></p>
        <dl class="bank-rows">
          <dt><%= t("invoice.bank_name") %></dt>
          <dd><%= @business.bank_name %></dd>

          <dt><%= t("invoice.bank_branch") %></dt>
          <dd><%= @business.bank_branch %></dd>

          <dt><%= t("invoice.bank_account_type") %></dt>
          <dd><%= @business.bank_account_type %></dd>

          <dt><%= t("invoice.bank_account_number") %></dt>
          <dd class="bank-num"><%= @business.bank_account_number %></dd>

          <dt><%= t("invoice.bank_account_holder") %></dt>
          <dd class="bank-holder"><%= @business.bank_account_holder %></dd>
        </dl>
      </div>
    <% end %>
  </div>
<% end %>
