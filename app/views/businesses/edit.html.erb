<div class="page-header">
  <h1>Business Settings</h1>
</div>

<% if flash[:token] %>
  <dialog class="modal" aria-labelledby="new_token_title" data-controller="modal">
    <h2 id="new_token_title">Token created</h2>
    <p class="text-muted">Copy it now, it won't be shown again.</p>
    <div class="copy-field" data-controller="clipboard">
      <code data-clipboard-target="source"><%= flash[:token] %></code>
      <button type="button" class="btn btn-sm" data-clipboard-target="button" data-action="clipboard#copy">Copy</button>
    </div>
    <form method="dialog" class="form-actions">
      <button class="btn btn-primary">Done</button>
    </form>
  </dialog>
<% end %>

<%= render "form", business: @business %>

<h2 class="mt-3">API Tokens</h2>
<p class="text-muted">"Chrome extension" tokens log extra hours from the extension; "Read invoices" tokens let an AI agent read invoices through the MCP server.</p>

<%= form_with model: ApiToken.new, url: business_api_tokens_path, class: "form-inline form-narrow mb-2" do |f| %>
  <div class="form-group">
    <%= f.label :name, "Token name" %>
    <%= f.text_field :name, placeholder: "e.g. Chrome extension" %>
  </div>
  <div class="form-group">
    <%= f.label :purpose %>
    <%= f.select :purpose, ApiToken.purposes.keys.map { [ it.humanize, it ] } %>
  </div>
  <%= f.submit "Generate token", class: "btn btn-primary", data: { turbo_submits_with: "Generating..." } %>
<% end %>

<% if Current.user.api_tokens.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Purpose</th>
        <th>Last used</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% Current.user.api_tokens.order(created_at: :desc).each do |token| %>
        <tr>
          <td><%= token.name %></td>
          <td><%= token.purpose.humanize %></td>
          <td class="text-muted"><%= token.last_used_at ? l(token.last_used_at, format: :short) : "Never" %></td>
          <td class="text-muted"><%= l token.created_at, format: :short %></td>
          <td class="text-right">
            <%= button_to "Revoke", business_api_token_path(token), method: :delete, class: "btn btn-sm btn-danger", data: { turbo_confirm: "Revoke this token?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
