<div class="page-header">
  <h1>Business Settings</h1>
</div>

<% if flash[:token] %>
  <div class="flash flash-notice">
    Token created. Copy it now, it won't be shown again: <code><%= flash[:token] %></code>
  </div>
<% end %>

<%= render "form", business: @business %>

<h2 class="mt-3">API Tokens</h2>
<p class="text-muted">Tokens authenticate the Chrome extension against the API.</p>

<%= form_with model: ApiToken.new, url: business_api_tokens_path, class: "form-inline form-narrow mb-2" do |f| %>
  <div class="form-group">
    <%= f.label :name, "Token name" %>
    <%= f.text_field :name, placeholder: "e.g. Chrome extension" %>
  </div>
  <%= f.submit "Generate token", class: "btn btn-primary", data: { turbo_submits_with: "Generating..." } %>
<% end %>

<% if Current.user.api_tokens.any? %>
  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Last used</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% Current.user.api_tokens.order(created_at: :desc).each do |token| %>
        <tr>
          <td><%= token.name %></td>
          <td class="text-muted"><%= token.last_used_at ? l(token.last_used_at, format: :short) : "Never" %></td>
          <td class="text-muted"><%= l token.created_at, format: :short %></td>
          <td class="text-right">
            <%= button_to "Revoke", business_api_token_path(token), method: :delete, class: "btn btn-sm btn-danger", data: { turbo_confirm: "Revoke this token?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
