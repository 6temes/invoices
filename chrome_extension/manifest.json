{
  "manifest_version": 3,
  "name": "Invoice Hours Logger",
  "version": "1.0.0",
  "description": "Log extra hours directly from GitHub issues and pull requests",
  "permissions": ["storage"],
  "host_permissions": ["https://github.com/*"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/issues/*", "https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
